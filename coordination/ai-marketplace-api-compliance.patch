+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {
+  buyerVietqrSnapshot,
+  quoteBuyerVietqrWithdrawal,
+  isBuyerDepositWithdrawal,
+} = require('../../src/finance/buyer-deposit-withdraw');
+const { sellerEarnedAvailable } = require('../../src/finance/withdrawable-balance');
+
+const vietqr = (amount) => ({
+  type: 'deposit',
+  amount,
+  status: 'completed',
+  paymentMethod: 'bank_transfer',
+  meta: { kind: 'bank_transfer_vietqr' },
+});
+
+test('VietQR deposits are withdrawable only after spends and only up to the pool', () => {
+  const snap = buyerVietqrSnapshot([vietqr(40), { type: 'debit', amount: 15, status: 'completed' }], 30);
+  assert.equal(snap.payableUsd, 25);
+  assert.equal(snap.refundsIncluded, false);
+  const quote = quoteBuyerVietqrWithdrawal({ amountUsd: 25, snapshot: snap, electronicIdentityVerified: true });
+  assert.equal(quote.ok, true);
+  assert.equal(quoteBuyerVietqrWithdrawal({ amountUsd: 25.01, snapshot: snap, electronicIdentityVerified: true }).code, 'DEPOSIT_CAP');
+});
+
+test('electronic identity is required and a manual seller flag is not accepted by this function', () => {
+  const snap = buyerVietqrSnapshot([vietqr(10)], 10);
+  assert.equal(quoteBuyerVietqrWithdrawal({ amountUsd: 10, snapshot: snap, electronicIdentityVerified: false }).code, 'KYC_REQUIRED');
+});
+
+test('App Store, Google Play, GPay and unknown deposits are excluded', () => {
+  const iap = buyerVietqrSnapshot([
+    { type: 'deposit', amount: 80, status: 'completed', paymentMethod: 'iap' },
+  ], 80);
+  assert.equal(iap.payableUsd, 0);
+  assert.deepEqual(iap.blockedSources, ['appstore']);
+  assert.equal(quoteBuyerVietqrWithdrawal({ amountUsd: 10, snapshot: iap, electronicIdentityVerified: true }).code, 'APPSTORE_UNRESOLVED');
+
+  const gpay = buyerVietqrSnapshot([
+    { type: 'deposit', amount: 20, status: 'completed', paymentMethod: 'gpay' },
+  ], 20);
+  assert.equal(quoteBuyerVietqrWithdrawal({ amountUsd: 5, snapshot: gpay, electronicIdentityVerified: true }).code, 'GPAY_REMOVED');
+
+  const unknown = buyerVietqrSnapshot([
+    { type: 'deposit', amount: 12, status: 'completed', paymentMethod: '' },
+  ], 12);
+  assert.equal(unknown.payableUsd, 0);
+  assert.deepEqual(unknown.blockedSources, ['unknown']);
+});
+
+test('spending consumes VietQR before any excluded deposit can be cashed out', () => {
+  const snap = buyerVietqrSnapshot([
+    vietqr(30),
+    { type: 'deposit', amount: 50, status: 'completed', paymentMethod: 'iap' },
+    { type: 'debit', amount: 30, status: 'completed' },
+  ], 50);
+  assert.equal(snap.payableUsd, 0);
+  assert.equal(snap.appstoreUsd, 50);
+});
+
+test('refund credits are not treated as a withdrawable deposit', () => {
+  const snap = buyerVietqrSnapshot([
+    { type: 'credit', amount: 40, status: 'completed', note: 'Refund rf1' },
+  ], 40);
+  assert.equal(snap.payableUsd, 0);
+  assert.equal(snap.vietqrDepositedUsd, 0);
+});
+
+test('a pending VietQR withdrawal reserves the slice and does not reduce seller earnings', () => {
+  const withdrawal = {
+    type: 'withdraw',
+    amount: 10,
+    status: 'pending',
+    meta: { persona: 'buyer', source: 'vietqr_company_bank' },
+  };
+  assert.equal(isBuyerDepositWithdrawal(withdrawal), true);
+  const snap = buyerVietqrSnapshot([vietqr(25), withdrawal], 25);
+  assert.equal(snap.payableUsd, 15);
+  const earned = sellerEarnedAvailable({
+    orders: [{ status: 'paid', ownershipType: 'THIRD_PARTY_SELLER', sellerNetAmount: 40, payoutHoldUntil: new Date('2020-01-01') }],
+    walletTxs: [withdrawal],
+    now: new Date('2026-11-08'),
+  });
+  assert.equal(earned.available, 40);
+});
