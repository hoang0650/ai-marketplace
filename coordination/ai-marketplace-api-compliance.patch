index 0000000..4f87260
--- /dev/null
+++ b/src/finance/buyer-deposit-withdraw.js
@@ -0,0 +1,93 @@
+const { roundMoney } = require('../utils/payout-hold');
+
+const APPSTORE = new Set(['iap', 'apple_pay', 'google_pay']);
+
+/** Classify a completed deposit. Unknown and removed channels are excluded from the payable amount. */
+function classifyDeposit(tx) {
+  const method = String(tx?.paymentMethod || '');
+  const kind = String(tx?.meta?.kind || '');
+  if (method === 'bank_transfer' || kind === 'bank_transfer_vietqr') return 'vietqr';
+  if (APPSTORE.has(method)) return 'appstore';
+  if (method === 'gpay' || kind.startsWith('gpay')) return 'gpay';
+  if (method) return 'other';
+  return 'unknown';
+}
+
+function isBuyerDepositWithdrawal(tx) {
+  return tx?.meta?.source === 'vietqr_company_bank' || tx?.meta?.persona === 'buyer';
+}
+
+/**
+ * VietQR company-bank deposits that can be paid back after electronic identity verification.
+ * Spends reduce that slice first, so App Store, Google Play, GPay and unclassified deposits
+ * are not cashed out. Refund credits are not deposits and are not added.
+ * `poolAvailable` is an upper cap (affiliate slice already removed by the caller).
+ */
+function buyerVietqrSnapshot(txs = [], poolAvailable = 0) {
+  let vietqr = 0;
+  let appstore = 0;
+  let gpay = 0;
+  let other = 0;
+  let spent = 0;
+  let withdrawn = 0;
+  for (const tx of txs) {
+    const status = tx.status || 'completed';
+    if (status === 'failed' || status === 'cancelled') continue;
+    const amount = Number(tx.amount) || 0;
+    if (!(amount > 0)) continue;
+    if (tx.type === 'deposit' && status === 'completed') {
+      const kind = classifyDeposit(tx);
+      if (kind === 'vietqr') vietqr += amount;
+      else if (kind === 'appstore') appstore += amount;
+      else if (kind === 'gpay') gpay += amount;
+      else other += amount;
+    } else if (tx.type === 'debit' && status === 'completed') {
+      spent += amount;
+    } else if (tx.type === 'withdraw' && (status === 'completed' || status === 'pending') && isBuyerDepositWithdrawal(tx)) {
+      withdrawn += amount;
+    }
+  }
+  const afterUse = Math.max(0, vietqr - spent - withdrawn);
+  const pool = Math.max(0, Number(poolAvailable) || 0);
+  const blockedSources = [];
+  if (appstore > 0) blockedSources.push('appstore');
+  if (gpay > 0) blockedSources.push('gpay');
+  if (other > 0) blockedSources.push('unknown');
+  return {
+    fundingSeparated: true,
+    settlement: 'VND',
+    refundsIncluded: false,
+    vietqrDepositedUsd: roundMoney(vietqr),
+    payableUsd: roundMoney(Math.min(afterUse, pool)),
+    appstoreUsd: roundMoney(appstore),
+    gpayUsd: roundMoney(gpay),
+    unknownUsd: roundMoney(other),
+    blockedSources,
+  };
+}
+
+function quoteBuyerVietqrWithdrawal({ amountUsd, snapshot, electronicIdentityVerified }) {
+  const payableUsd = roundMoney(snapshot?.payableUsd || 0);
+  if (!electronicIdentityVerified) {
+    return { ok: false, code: 'KYC_REQUIRED', payableUsd: 0 };
+  }
+  const amt = roundMoney(amountUsd);
+  if (!(amt > 0)) return { ok: false, code: 'INVALID_AMOUNT', payableUsd };
+  if (amt > payableUsd + 1e-9) {
+    if (payableUsd <= 0 && (snapshot?.appstoreUsd || 0) > 0 && (snapshot?.vietqrDepositedUsd || 0) <= 0) {
+      return { ok: false, code: 'APPSTORE_UNRESOLVED', payableUsd };
+    }
+    if (payableUsd <= 0 && (snapshot?.gpayUsd || 0) > 0 && (snapshot?.vietqrDepositedUsd || 0) <= 0) {
+      return { ok: false, code: 'GPAY_REMOVED', payableUsd };
+    }
+    return { ok: false, code: 'DEPOSIT_CAP', payableUsd };
+  }
+  return { ok: true, code: null, amountUsd: amt, payableUsd };
+}
+
+module.exports = {
+  classifyDeposit,
+  isBuyerDepositWithdrawal,
+  buyerVietqrSnapshot,
+  quoteBuyerVietqrWithdrawal,
+};
