{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -- --configuration=production",
  "outputDirectory": "dist/ai-marketplace/browser",
  "routes": [
    {
      "src": "/(main|chunk|polyfills|styles)-[A-Za-z0-9]+\\.(js|css)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/product/(gpu-rtx4090-hour|gpu-a100-train|gpu-l40s-infer)/?",
      "status": 308,
      "headers": { "Location": "/training/gpu", "Cache-Control": "no-store" }
    },
    { "handle": "filesystem" },
    {
      "src": "/.*\\.[A-Za-z0-9]{1,8}",
      "status": 404,
      "headers": { "Cache-Control": "no-store" },
      "dest": "/404-missing-asset"
    },
    {
      "src": "/(.*)",
      "headers": { "Cache-Control": "no-cache, must-revalidate" },
      "dest": "/index.html"
    }
  ]
}
